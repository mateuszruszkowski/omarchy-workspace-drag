#!/usr/bin/env bash
set -euo pipefail
app_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-status}" in
    start) exec qs --no-duplicate --daemonize --path "$app_dir/shell.qml" ;;
    settings) exec python3 "$app_dir/open_settings.py" ;;
    preview)
        exec python3 - "$app_dir" "${2:-}" <<'PYTHON'
import json
from pathlib import Path
import subprocess
import sys
import time

shell = str(Path(sys.argv[1]) / "shell.qml")

def call(method, *arguments):
    result = subprocess.run(["qs", "ipc", "--path", shell, "call", "workspaceDrag", method, *arguments],
                            capture_output=True, text=True, timeout=2)
    if result.returncode:
        return None
    try:
        return json.loads(result.stdout)
    except ValueError:
        return None

try:
    appearance = json.loads(sys.argv[2] or "{}")
    status = call("status")
    if status is None:
        started = subprocess.run(["qs", "--no-duplicate", "--daemonize", "--path", shell],
                                 capture_output=True, text=True, timeout=4)
        if started.returncode:
            raise RuntimeError("Nie udało się uruchomić usługi podglądu.")
    deadline = time.monotonic() + 4
    while not status or not status.get("ready"):
        if time.monotonic() >= deadline:
            raise RuntimeError("Usługa podglądu nie jest gotowa. Spróbuj ponownie.")
        time.sleep(.05)
        status = call("status")
    accepted = call("preview", json.dumps(appearance))
    if not accepted or not accepted.get("ok"):
        raise RuntimeError((accepted or {}).get("error", "Nie udało się połączyć z usługą podglądu."))
    deadline = time.monotonic() + 4
    while True:
        status = call("status") or {}
        if status.get("token") == accepted["token"] and status.get("mode") == "preview" and status.get("state") == "dragging":
            print(json.dumps({"ok": True}))
            break
        if status.get("previewToken") == accepted["token"] and status.get("previewError"):
            raise RuntimeError(status["previewError"])
        if time.monotonic() >= deadline:
            raise RuntimeError("Usługa nie potwierdziła otwarcia podglądu. Spróbuj ponownie.")
        time.sleep(.05)
except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as error:
    message = str(error) if isinstance(error, RuntimeError) else "Nie udało się otworzyć podglądu."
    print(json.dumps({"ok": False, "error": message}, ensure_ascii=False))
    sys.exit(1)
PYTHON
        ;;
    stop) exec qs kill --path "$app_dir/shell.qml" ;;
    begin|end)
        pointer=""
        if [ "$#" -ge 4 ]; then printf -v pointer '{"x":%s,"y":%s}' "$3" "$4"; fi
        exec qs ipc --path "$app_dir/shell.qml" call workspaceDrag "$1" "${2:-manual}" "$pointer" ;;
    keyboard)
        exec python3 - "$app_dir" "${@:2}" <<'PYTHON'
import json
from pathlib import Path
import re
import subprocess
import sys
try:
    root, token, action, address, workspace, monitor, sequence, monitor_step, workspace_step, digit, source_mode = sys.argv[1:]
    if (not re.fullmatch(r"[A-Za-z0-9-]{1,100}", token) or action not in ("begin", "pin", "navigate", "commit", "cancel")
            or not re.fullmatch(r"0x[0-9a-fA-F]+", address) or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,100}", monitor)):
        raise ValueError()
    workspace, sequence, monitor_step, workspace_step, digit = map(int, (workspace, sequence, monitor_step, workspace_step, digit))
    if source_mode not in ("active", "pointer") or workspace < 1 or sequence < 1 or abs(monitor_step) > 100000 or abs(workspace_step) > 100000 or not 0 <= digit <= 10:
        raise ValueError()
    message = dict(command="keyboard", token=token, action=action, source=dict(address=address, workspace=workspace, monitor=monitor, mode=source_mode),
                   sequence=sequence, monitorStep=monitor_step, workspaceStep=workspace_step)
    if digit: message["digit"] = digit
    result = subprocess.run(["qs", "ipc", "--path", str(Path(root) / "shell.qml"), "call", "workspaceDrag", "keyboard", json.dumps(message)], timeout=3)
    sys.exit(result.returncode)
except (ValueError, OSError, subprocess.TimeoutExpired):
    sys.exit(2)
PYTHON
        ;;
    cancel) exec qs ipc --path "$app_dir/shell.qml" call workspaceDrag cancel "${2:-manual}" ;;
    status|demo) exec qs ipc --path "$app_dir/shell.qml" call workspaceDrag "$1" ;;
    *) echo 'Usage: workspace-drag {start|stop|settings|status|begin TOKEN|end TOKEN|cancel|demo|preview JSON}' >&2; exit 2 ;;
esac
